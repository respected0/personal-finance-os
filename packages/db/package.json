{
  "name": "@personal-finance-os/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:daily-core": "node tests/daily-core/local-daily-core.mjs",
    "test:cards": "node tests/cards/local-cards.mjs",
    "test:subscriptions": "node tests/subscriptions/local-subscriptions.mjs",
    "test:sharing": "node tests/sharing/local-sharing.mjs",
    "test:reconciliation": "node tests/reconciliation/local-reconciliation.mjs",
    "test:reports": "node tests/reports/local-monthly-reports.mjs",
    "test:data-lifecycle": "node tests/data-lifecycle/local-data-lifecycle.mjs",
    "test:planning": "node tests/planning/local-planning.mjs",
    "test:investments": "node tests/investments/local-investments.mjs",
    "test:recommendations": "node tests/recommendations/local-recommendations.mjs",
    "test:ledger": "node tests/ledger/local-ledger.mjs",
    "test:rls": "node tests/rls/local-rls.mjs",
    "typecheck": "pnpm --filter @personal-finance-os/domain build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@personal-finance-os/domain": "workspace:0.0.0",
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.111.0",
    "@types/node": "24.13.3",
    "drizzle-kit": "0.31.10"
  }
}
